rules_version = '2';

// Filmroom security rules.
// Paste these into Firebase Console ▸ Firestore ▸ Rules ▸ Publish.
// If you change the admin email in js/config.js, change ADMIN_EMAIL() below too.

service cloud.firestore {
  match /databases/{database}/documents {

    function ADMIN_EMAIL() { return 'youssef.imnm@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() { return signedIn() && myProfile().status == 'approved'; }
    function isAdmin() {
      return signedIn() && myProfile().role == 'admin' && myProfile().status == 'approved';
    }
    function roomMembers(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // ---- Users ----
    match /users/{uid} {
      // Sign up: create only your own doc, with your real email, as a pending
      // member — unless you're the admin email, who may self-provision as admin.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'member')
          || (request.auth.token.email == ADMIN_EMAIL()
              && request.resource.data.status == 'approved'
              && request.resource.data.role == 'admin')
        );
      allow read: if request.auth.uid == uid || isApproved();
      allow update, delete: if isAdmin();   // only admin flips status/role

      // Personal diary — private to its owner.
      match /diary/{filmId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- App config (admin settings) ----
    match /config/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ---- Rooms ----
    match /rooms/{roomId} {
      allow read:   if isApproved() && request.auth.uid in resource.data.members;
      allow create: if isApproved() && request.auth.uid in request.resource.data.members;
      allow update: if isAdmin()
        || (isApproved() && request.auth.uid in resource.data.members);
      allow delete: if isAdmin()
        || (isApproved() && request.auth.uid == resource.data.createdBy);

      match /films/{filmId} {
        allow read, create, update: if isApproved() && request.auth.uid in roomMembers(roomId);
        allow delete: if isAdmin();

        match /takes/{uid} {
          allow read:  if isApproved() && request.auth.uid in roomMembers(roomId);
          // You may only write your own take, and only if you're in the room.
          allow write: if isApproved() && request.auth.uid == uid
                       && request.auth.uid in roomMembers(roomId);
        }
      }
    }
  }
}
